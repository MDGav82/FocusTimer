@startuml pomodoro_components
left to right direction

skinparam component {
  BackgroundColor #FEFEFE
  BorderColor #444444
  FontSize 13
}

skinparam interface {
  BackgroundColor #87CEEB
  BorderColor #336699
}

skinparam package {
  BackgroundColor #F8F8FF
  BorderColor #888888
}

' ===========================
' Frontend
' ===========================

package "Interface Utilisateur (Frontend)" {

  package "Timer Module" {
    component [PomodoroTimer UI] as TimerUI
    component [Période Display] as PeriodUI
  }

  package "Task Module" {
    component [TaskList UI] as TaskUI
    component [TaskForm UI] as TaskFormUI
  }

  package "Cycle Module" {
    component [CycleSelector UI] as CycleUI
    component [CycleForm UI] as CycleFormUI
  }

  package "Stats & History Module" {
    component [History UI] as HistoryUI
    component [Statistics UI] as StatsUI
  }

  package "Settings Module" {
    component [Parameters UI] as ParamUI
    component [Profile UI] as ProfileUI
  }

}

' ===========================
' Services métier (Frontend)
' ===========================

package "Services (Frontend)" {
  component [TimerService] as TimerSvc
  component [TaskService] as TaskSvc
  component [CycleService] as CycleSvc
  component [HistoryService] as HistorySvc
  component [NotificationService] as NotifSvc
  component [AuthService] as AuthSvc
}

' ===========================
' Backend / API
' ===========================

package "Backend API" {
  component [User API] as UserAPI
  component [Task API] as TaskAPI
  component [Cycle API] as CycleAPI
  component [History API] as HistoryAPI
}

' ===========================
' Stockage
' ===========================

database "Base de données" as DB
database "Stockage local\n(non connecté)" as LocalStorage

' ===========================
' Interfaces exposées
' ===========================

interface "ITimer" as ITimer
interface "ITask" as ITask
interface "ICycle" as ICycle
interface "INotification" as INotif
interface "IAuth" as IAuth
interface "REST API" as REST

' ===========================
' Relations UI -> Services
' ===========================

TimerUI --> ITimer
ITimer -- TimerSvc

TaskUI --> ITask
TaskFormUI --> ITask
ITask -- TaskSvc

CycleUI --> ICycle
CycleFormUI --> ICycle
ICycle -- CycleSvc

HistoryUI --> HistorySvc
StatsUI --> HistorySvc

ParamUI --> NotifSvc
ParamUI --> TimerSvc
ProfileUI --> AuthSvc

TimerSvc ..> NotifSvc : notifie
TimerSvc ..> HistorySvc : enregistre

' ===========================
' Relations Services -> API
' ===========================

AuthSvc --> IAuth
IAuth -- REST

TaskSvc --> REST
CycleSvc --> REST
HistorySvc --> REST

' ===========================
' Relations API -> Stockage
' ===========================

REST -- UserAPI
REST -- TaskAPI
REST -- CycleAPI
REST -- HistoryAPI

UserAPI --> DB
TaskAPI --> DB
CycleAPI --> DB
HistoryAPI --> DB

TaskSvc ..> LocalStorage : fallback non connecté
CycleSvc ..> LocalStorage : fallback non connecté

@enduml
